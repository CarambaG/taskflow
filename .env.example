APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=change-me-taskflow-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_DSN=taskflow:change-me-taskflow-password@tcp(mysql:3306)/taskflow?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_TTL=24h
TASK_CACHE_TTL=5m
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
LOG_LEVEL=info
